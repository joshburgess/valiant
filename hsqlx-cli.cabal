cabal-version:   3.0
name:            hsqlx-cli
version:         0.1.0.0
synopsis:        Compile-time checked SQL for Haskell — CLI tool
description:
  The @hsqlx@ CLI tool connects to a live PostgreSQL database,
  validates @.sql@ files via @PREPARE@ / @DESCRIBE@, and caches
  type metadata for the GHC source plugin to consume at compile time.
license:         BSD-3-Clause
license-file:    LICENSE
build-type:      Simple

common warnings
  ghc-options: -Wall -Wcompat -Wno-unticked-promoted-constructors

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions:
    DeriveAnyClass
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    RecordWildCards
    StrictData

  exposed-modules:
    Hsqlx.CLI.App
    Hsqlx.CLI.Cache
    Hsqlx.CLI.Command.Check
    Hsqlx.CLI.Command.Generate
    Hsqlx.CLI.Command.Prepare
    Hsqlx.CLI.Command.Types
    Hsqlx.CLI.Command.Watch
    Hsqlx.CLI.Config
    Hsqlx.CLI.CustomTypes
    Hsqlx.CLI.Describe
    Hsqlx.CLI.Discover
    Hsqlx.CLI.Error
    Hsqlx.CLI.Hash
    Hsqlx.CLI.Nullability
    Hsqlx.CLI.Output
    Hsqlx.CLI.SqlMetadata
    Hsqlx.CLI.TypeMap

  build-depends:
    , aeson                 >=2.1     && <2.3
    , aeson-pretty          >=0.8     && <0.9
    , ansi-terminal         >=1.0     && <1.2
    , base                  >=4.17    && <5
    , bytestring            >=0.11    && <0.13
    , containers            >=0.6     && <0.8
    , cryptohash-sha256     >=0.11    && <0.12
    , directory             >=1.3     && <1.4
    , dotenv                >=0.11    && <0.13
    , filepath              >=1.4     && <1.6
    , Glob                  >=0.10    && <0.11
    , optparse-applicative  >=0.18    && <0.19
    , postgresql-libpq      >=0.10    && <0.11
    , text                  >=2.0     && <2.2
    , time                  >=1.12    && <1.15
    , vector                >=0.13    && <0.14

executable hsqlx
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  default-language: GHC2021
  build-depends:
    , base       >=4.17 && <5
    , hsqlx-cli
  ghc-options:      -threaded -rtsopts

test-suite hsqlx-cli-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  default-language: GHC2021
  default-extensions:
    OverloadedStrings

  other-modules:
    Hsqlx.CLI.CacheSpec
    Hsqlx.CLI.CustomTypesSpec
    Hsqlx.CLI.DiscoverSpec
    Hsqlx.CLI.ErrorSpec
    Hsqlx.CLI.HashSpec
    Hsqlx.CLI.SqlMetadataSpec
    Hsqlx.CLI.TypeMapSpec

  build-depends:
    , aeson
    , base             >=4.17 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , hspec            >=2.11 && <2.12
    , hsqlx-cli
    , postgresql-libpq
    , temporary        >=1.3  && <1.4
    , text
    , time
