cabal-version:   3.0
name:            hsqlx
version:         0.1.0.0
synopsis:        Compile-time checked SQL for Haskell — runtime library
description:
  Runtime library for hsqlx. Provides the @Statement@ type, binary format
  codecs, query execution functions, and re-exports from @pg-wire@ (the
  underlying PostgreSQL wire protocol driver).
license:         BSD-3-Clause
license-file:    ../LICENSE
build-type:      Simple

common warnings
  ghc-options: -Wall -Wcompat -Wno-unticked-promoted-constructors

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    RecordWildCards
    StrictData

  exposed-modules:
    Hsqlx
    -- Re-exports from pg-wire (backwards compatibility)
    Hsqlx.Auth.Cleartext
    Hsqlx.Auth.MD5
    Hsqlx.Auth.ScramSHA256
    Hsqlx.Binary.Types
    Hsqlx.Cancel
    Hsqlx.Connection
    Hsqlx.Connection.Config
    Hsqlx.Error
    Hsqlx.Pool
    Hsqlx.Pool.Config
    Hsqlx.Protocol.Backend
    Hsqlx.Protocol.Builders
    Hsqlx.Protocol.Frontend
    Hsqlx.Protocol.Oid
    Hsqlx.Protocol.Parsers
    Hsqlx.Wire
    -- hsqlx-specific modules
    Hsqlx.Binary.Array
    Hsqlx.Binary.Composite
    Hsqlx.Binary.Decode
    Hsqlx.Binary.Encode
    Hsqlx.Binary.Interval
    Hsqlx.Binary.Range
    Hsqlx.Binary.Scientific
    Hsqlx.Copy
    Hsqlx.Execute
    Hsqlx.FromRow
    Hsqlx.Logging
    Hsqlx.Notify
    Hsqlx.Statement
    Hsqlx.Streaming
    Hsqlx.ToParams
    Hsqlx.Transaction

  build-depends:
    -- Wire protocol driver
    , pg-wire

    -- Core
    , base                  >=4.17    && <5
    , bytestring            >=0.11    && <0.13
    , text                  >=2.0     && <2.2
    , containers            >=0.6     && <0.8
    , vector                >=0.13    && <0.14
    , time                  >=1.12    && <1.15
    , deepseq               >=1.4     && <1.6

    -- Binary codec helpers
    , scientific            >=0.3     && <0.4
    , uuid-types            >=1.0     && <1.1
    , aeson                 >=2.1     && <2.3

    -- Concurrency (for Streaming, Notify)
    , async                 >=2.2     && <2.3

    -- Network (for Cancel, Notify)
    , network               >=3.1     && <3.3

test-suite hsqlx-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  default-language: GHC2021
  default-extensions:
    OverloadedStrings

  other-modules:
    Hsqlx.Binary.ArraySpec
    Hsqlx.Binary.CompositeSpec
    Hsqlx.Binary.DecodeSpec
    Hsqlx.Binary.EncodeSpec
    Hsqlx.Binary.IntervalSpec
    Hsqlx.Binary.PropertySpec
    Hsqlx.Binary.RangeSpec
    Hsqlx.Binary.ScientificSpec
    Hsqlx.FromRowSpec

  build-depends:
    , base           >=4.17 && <5
    , bytestring
    , hspec          >=2.11 && <2.12
    , hsqlx
    , QuickCheck     >=2.14 && <2.16
    , scientific
    , text
    , time
    , vector

test-suite hsqlx-integration
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   integration
  main-is:          Main.hs
  default-language: GHC2021
  default-extensions:
    OverloadedStrings

  other-modules:
    ConnectionSpec
    CopySpec
    ExecuteSpec
    PoolSpec
    TestSupport
    TransactionSpec

  build-depends:
    , async        >=2.2  && <2.3
    , base         >=4.17 && <5
    , bytestring
    , hspec        >=2.11 && <2.12
    , hsqlx
    , text

  -- Requires DATABASE_URL. Run with:
  --   eval $(scripts/pg-setup.sh)
  --   cabal test hsqlx-integration --test-show-details=direct

benchmark hsqlx-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   bench
  main-is:          Main.hs
  default-language: GHC2021
  default-extensions:
    OverloadedStrings

  other-modules:
    BenchCodec
    BenchQuery
    TestSupport

  build-depends:
    , base         >=4.17 && <5
    , bytestring
    , criterion    >=1.6  && <1.7
    , hsqlx
    , scientific
    , text
    , time
    , vector
  ghc-options: -threaded -rtsopts -O2
