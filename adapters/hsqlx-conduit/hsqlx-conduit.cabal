cabal-version:   3.0
name:            hsqlx-conduit
version:         0.1.0.0
synopsis:        Conduit streaming adapter for hsqlx
description:
  Stream PostgreSQL query results as Conduit sources. Provides cursor-based
  streaming via @sourceQuery@ and fold-based streaming via @sourceRows@,
  both producing @ConduitT () r m ()@ values compatible with the conduit
  ecosystem.
license:         BSD-3-Clause
license-file:    ../../LICENSE
build-type:      Simple

common warnings
  ghc-options: -Wall -Wcompat -Werror -Wno-unticked-promoted-constructors -funbox-strict-fields

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    OverloadedStrings
    StrictData

  exposed-modules:
    Hsqlx.Conduit

  build-depends:
    , base            >=4.17 && <5
    , bytestring      >=0.11 && <0.13
    , conduit         >=1.3  && <1.4
    , hsqlx
    , pg-wire
    , vector          >=0.12 && <0.14
