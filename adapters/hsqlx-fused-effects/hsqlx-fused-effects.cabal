cabal-version:   3.0
name:            hsqlx-fused-effects
version:         0.1.0.0
synopsis:        Fused-effects adapter for hsqlx
description:
  Provides an @Hsqlx@ effect and @HsqlxPoolC@ carrier for the
  @fused-effects@ effect system, enabling compile-time checked SQL
  queries as an algebraic effect.

  @
  import Hsqlx.FusedEffects

  myApp :: Has Hsqlx sig m => m [User]
  myApp = do
    users <- fetchAllF listUsers ()
    pure users

  main :: IO ()
  main = do
    pool <- newPool defaultPoolConfig { poolConnString = "..." }
    result <- runHsqlxPool pool myApp
    print result
  @
license:         BSD-3-Clause
license-file:    ../../LICENSE
build-type:      Simple

common warnings
  ghc-options: -Wall -Wcompat -Werror -Wno-unticked-promoted-constructors -funbox-strict-fields -fspecialise-aggressively

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    KindSignatures
    LambdaCase
    MultiParamTypeClasses
    OverloadedStrings
    ScopedTypeVariables
    StrictData
    TypeOperators
    UndecidableInstances

  exposed-modules:
    Hsqlx.FusedEffects

  build-depends:
    , base            >=4.17 && <5
    , fused-effects   >=1.1  && <1.3
    , hsqlx
    , pg-wire
