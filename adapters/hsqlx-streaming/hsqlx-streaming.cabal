cabal-version:   3.0
name:            hsqlx-streaming
version:         0.1.0.0
synopsis:        Streaming adapter for hsqlx (streaming library)
description:
  Stream PostgreSQL query results using the @streaming@ library.
  Provides cursor-based and fold-based producers as @Stream (Of r) IO ()@
  values.
license:         BSD-3-Clause
license-file:    ../../LICENSE
build-type:      Simple

common warnings
  ghc-options: -Wall -Wcompat -Werror -Wno-unticked-promoted-constructors -funbox-strict-fields

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    OverloadedStrings
    StrictData

  exposed-modules:
    Hsqlx.Stream

  build-depends:
    , base            >=4.17 && <5
    , bytestring      >=0.11 && <0.13
    , hsqlx
    , pg-wire
    , streaming       >=0.2  && <0.3
    , vector          >=0.12 && <0.14

test-suite hsqlx-streaming-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  default-language: GHC2021
  default-extensions:
    OverloadedStrings

  other-modules:
    TestSupport

  build-depends:
    , base            >=4.17 && <5
    , bytestring      >=0.11 && <0.13
    , hspec           >=2.11 && <2.12
    , hsqlx
    , hsqlx-streaming
    , pg-wire
    , streaming       >=0.2  && <0.3
    , text            >=2.0  && <2.2
