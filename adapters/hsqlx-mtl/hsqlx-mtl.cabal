cabal-version:   3.0
name:            hsqlx-mtl
version:         0.1.0.0
synopsis:        MTL-style adapter for hsqlx
description:
  Provides hsqlx database operations as MTL-style functions that work in
  any monad with @MonadReader pool m@ and @MonadIO m@ constraints. Unlike
  the built-in @Hsqlx.Monad@ (which is @ReaderT Pool IO@), this adapter
  composes with arbitrary monad stacks.

  @
  import Hsqlx.Mtl

  myApp :: (HasPool m, MonadIO m) => m [User]
  myApp = do
    users <- fetchAllMtl listUsers ()
    pure users
  @
license:         BSD-3-Clause
license-file:    ../../LICENSE
build-type:      Simple

common warnings
  ghc-options: -Wall -Wcompat -Werror -Wno-unticked-promoted-constructors -funbox-strict-fields -fspecialise-aggressively

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    FlexibleContexts
    OverloadedStrings
    StrictData

  exposed-modules:
    Hsqlx.Monad
    Hsqlx.Mtl

  build-depends:
    , base            >=4.17 && <5
    , hsqlx
    , mtl             >=2.2  && <2.4
    , pg-wire
    , time            >=1.12 && <1.15
    , transformers    >=0.6  && <0.7
    , vector          >=0.12 && <0.14
