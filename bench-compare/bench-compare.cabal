cabal-version:   3.0
name:            bench-compare
version:         0.1.0.0
license:         BSD-3-Clause
license-file:    ../LICENSE
build-type:      Simple

common warnings
  ghc-options: -Wall -Wcompat -Wno-unticked-promoted-constructors

executable bench-compare
  import:           warnings
  hs-source-dirs:   src
  main-is:          Main.hs
  default-language: GHC2021
  default-extensions:
    OverloadedStrings

  other-modules:
    BenchValiant
    BenchHasql
    BenchPgSimple
    BenchPersistent

  build-depends:
    , base                   >=4.17 && <5
    , bytestring
    , contravariant
    , criterion              >=1.6  && <1.8
    , text
    , vector

    -- valiant (our runtime)
    , valiant

    -- hasql ecosystem
    , hasql                  >=1.6  && <1.11

    -- postgresql-simple
    , postgresql-simple      >=0.6  && <0.8

    -- persistent (ORM)
    , persistent             >=2.14 && <2.19
    , persistent-postgresql  >=2.13 && <2.15
    , monad-logger           >=0.3  && <0.4
    , resource-pool          >=0.2  && <0.5
    , resourcet              >=1.2  && <1.4


  ghc-options: -threaded -rtsopts -O2
