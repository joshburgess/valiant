    "sql": "SELECT p.id, p.title, u.name as author_name, p.published_at\nFROM posts p\nJOIN users u ON u.id = p.author_id\nWHERE p.published_at IS NOT NULL\nORDER BY p.published_at DESC\nLIMIT $1\n",
