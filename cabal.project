with-compiler: ghc-9.10.3
packages: . runtime wire example deps/entropy plugin
          adapters/valiant-bluefin
          adapters/valiant-conduit
          adapters/valiant-effectful
          adapters/valiant-fused-effects
          adapters/valiant-mtl
          adapters/valiant-pipes
          adapters/valiant-streaming
          adapters/valiant-streamly
tests: True

package pg-wire
  flags: +werror

package valiant
  flags: +werror

package valiant-cli
  flags: +werror

package valiant-plugin
  flags: +werror

package valiant-bluefin
  flags: +werror

package valiant-conduit
  flags: +werror

package valiant-effectful
  flags: +werror

package valiant-fused-effects
  flags: +werror

package valiant-mtl
  flags: +werror

package valiant-pipes
  flags: +werror

package valiant-streaming
  flags: +werror

package valiant-streamly
  flags: +werror

package text
  flags: -simdutf
